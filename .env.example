# Database (local Docker)
DATABASE_URL="postgresql://raanko:raanko_dev@localhost:5432/raanko_dev?schema=public"

# Redis (local Docker)
REDIS_URL="redis://localhost:6379"

# API
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development

# JWT (generate secure secrets for staging/production)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m

# Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Email (Resend — Slice 3+)
# RESEND_API_KEY=

# Object storage (Cloudflare R2 — Slice 9+)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
