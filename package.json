{
  "name": "raanko",
  "version": "0.1.0",
  "private": true,
  "description": "RAANKO multi-tenant logistics and freight management SaaS",
  "scripts": {
    "dev": "pnpm run --parallel dev",
    "dev:api": "pnpm --filter @raanko/api dev",
    "dev:web": "pnpm --filter @raanko/web dev",
    "build": "pnpm run -r build",
    "lint": "pnpm run -r lint",
    "typecheck": "pnpm run -r typecheck",
    "test": "pnpm run -r test",
    "db:generate": "pnpm --filter @raanko/api db:generate",
    "db:migrate": "pnpm --filter @raanko/api db:migrate",
    "db:push": "pnpm --filter @raanko/api db:push"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
