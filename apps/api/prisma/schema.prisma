generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum AuthSurface {
  platform
  company
  portal
}

enum PlatformRoleKey {
  super_admin
  support_agent
}

enum MembershipStatus {
  invited
  active
  suspended
  removed
}

enum TenantStatus {
  trial
  active
  read_only
  suspended
  cancelled
  archived
}

enum WriteMode {
  full
  read_only
  blocked
}

enum SubscriptionStatus {
  trial
  active
  past_due
  cancelled
  expired
}

enum InvitationKind {
  owner
  employee
}

enum InvitationStatus {
  pending
  accepted
  expired
  revoked
}

enum LoginActivityResult {
  success
  failure
}

// ─── GLOBAL identity ─────────────────────────────────────────────────────────

model User {
  id                   String    @id @db.Char(26)
  email                String    @unique
  passwordHash         String    @map("password_hash")
  firstName            String?   @map("first_name")
  lastName             String?   @map("last_name")
  emailVerifiedAt      DateTime? @map("email_verified_at")
  totpSecretEncrypted  String?   @map("totp_secret_encrypted")
  totpEnabledAt        DateTime? @map("totp_enabled_at")
  failedLoginAttempts  Int       @default(0) @map("failed_login_attempts")
  lockedUntil          DateTime? @map("locked_until")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  sessions                 Session[]
  refreshTokens            RefreshToken[]
  platformRoleAssignments  PlatformRoleAssignment[]
  memberships              Membership[]
  loginActivities          LoginActivity[]
  invitationsSent          Invitation[]             @relation("InvitationInviter")
  portalAccounts           PortalAccount[]
  impersonationSessions    ImpersonationSession[]
  platformAuditLogs        PlatformAuditLog[]

  @@map("users")
}

model Session {
  id            String       @id @db.Char(26)
  userId        String       @map("user_id") @db.Char(26)
  authSurface   AuthSurface  @map("auth_surface")
  tenantId      String?      @map("tenant_id") @db.Char(26)
  membershipId  String?      @map("membership_id") @db.Char(26)
  portalAccountId String?    @map("portal_account_id") @db.Char(26)
  ipAddress     String?      @map("ip_address")
  userAgent     String?      @map("user_agent")
  deviceLabel   String?      @map("device_label")
  createdAt     DateTime     @default(now()) @map("created_at")
  lastSeenAt    DateTime     @default(now()) @map("last_seen_at")
  expiresAt     DateTime     @map("expires_at")
  revokedAt     DateTime?    @map("revoked_at")
  revokedReason String?      @map("revoked_reason")

  user          User           @relation(fields: [userId], references: [id])
  tenant        Tenant?        @relation(fields: [tenantId], references: [id])
  membership    Membership?    @relation(fields: [membershipId], references: [id])
  portalAccount PortalAccount? @relation(fields: [portalAccountId], references: [id])
  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([tenantId])
  @@map("sessions")
}

model RefreshToken {
  id             String      @id @db.Char(26)
  userId         String      @map("user_id") @db.Char(26)
  sessionId      String      @map("session_id") @db.Char(26)
  authSurface    AuthSurface @map("auth_surface")
  tenantId       String?     @map("tenant_id") @db.Char(26)
  membershipId   String?     @map("membership_id") @db.Char(26)
  portalAccountId String?    @map("portal_account_id") @db.Char(26)
  tokenHash      String      @map("token_hash")
  expiresAt      DateTime    @map("expires_at")
  revokedAt      DateTime?   @map("revoked_at")
  rotatedFromId  String?     @map("rotated_from_id") @db.Char(26)
  ipAddress      String?     @map("ip_address")
  userAgentHash  String?     @map("user_agent_hash")
  createdAt      DateTime    @default(now()) @map("created_at")

  user          User           @relation(fields: [userId], references: [id])
  session       Session        @relation(fields: [sessionId], references: [id])
  tenant        Tenant?        @relation(fields: [tenantId], references: [id])
  membership    Membership?    @relation(fields: [membershipId], references: [id])
  portalAccount PortalAccount? @relation(fields: [portalAccountId], references: [id])
  rotatedFrom   RefreshToken?  @relation("RefreshRotation", fields: [rotatedFromId], references: [id])
  rotatedTo     RefreshToken[] @relation("RefreshRotation")

  @@unique([tokenHash])
  @@index([sessionId])
  @@index([userId])
  @@map("refresh_tokens")
}

model PlatformRoleAssignment {
  id        String          @id @db.Char(26)
  userId    String          @map("user_id") @db.Char(26)
  role      PlatformRoleKey
  isActive  Boolean         @default(true) @map("is_active")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, role])
  @@map("platform_role_assignments")
}

model LoginActivity {
  id          String              @id @db.Char(26)
  userId      String?             @map("user_id") @db.Char(26)
  email       String
  authSurface AuthSurface         @map("auth_surface")
  tenantId    String?             @map("tenant_id") @db.Char(26)
  result      LoginActivityResult
  failureReason String?           @map("failure_reason")
  ipAddress   String?             @map("ip_address")
  userAgent   String?             @map("user_agent")
  createdAt   DateTime            @default(now()) @map("created_at")

  user   User?   @relation(fields: [userId], references: [id])
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([email, createdAt])
  @@index([userId])
  @@map("login_activities")
}

// ─── Entitlement catalog (GLOBAL) ────────────────────────────────────────────

model Plan {
  id          String   @id @db.Char(26)
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  features      PlanFeature[]
  subscriptions Subscription[]

  @@map("plans")
}

model Feature {
  id          String   @id @db.Char(26)
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  planFeatures PlanFeature[]
  overrides    TenantFeatureOverride[]

  @@map("features")
}

model PlanFeature {
  id        String   @id @db.Char(26)
  planId    String   @map("plan_id") @db.Char(26)
  featureId String   @map("feature_id") @db.Char(26)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  plan    Plan    @relation(fields: [planId], references: [id])
  feature Feature @relation(fields: [featureId], references: [id])

  @@unique([planId, featureId])
  @@map("plan_features")
}

// ─── TENANT_SCOPED ───────────────────────────────────────────────────────────

model Tenant {
  id                   String       @id @db.Char(26)
  slug                 String       @unique
  legalName            String       @map("legal_name")
  displayName          String       @map("display_name")
  status               TenantStatus @default(trial)
  writeMode            WriteMode    @default(full) @map("write_mode")
  defaultCurrency      String       @default("EUR") @map("default_currency") @db.Char(3)
  defaultLanguage      String       @default("en") @map("default_language")
  timezone             String       @default("UTC")
  // Branding
  logoUrl              String?      @map("logo_url")
  primaryColor         String?      @map("primary_color")
  secondaryColor       String?      @map("secondary_color")
  // Onboarding progress (JSON-ish flags)
  onboardingStep       String       @default("welcome") @map("onboarding_step")
  onboardingCompletedAt DateTime?   @map("onboarding_completed_at")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  branches         Branch[]
  roles            Role[]
  memberships      Membership[]
  subscriptions    Subscription[]
  featureOverrides TenantFeatureOverride[]
  invitations      Invitation[]
  sessions         Session[]
  refreshTokens    RefreshToken[]
  loginActivities  LoginActivity[]
  portalAccounts   PortalAccount[]
  permissions      Permission[]
  customers        Customer[]
  customerActivities CustomerActivity[]
  importJobs       ImportJob[]
  suppliers        Supplier[]
  rateSheets       RateSheet[]
  rateLines        RateLine[]
  chargeTemplates  ChargeTemplate[]
  quoteRequests    QuoteRequest[]
  quotes           Quote[]
  quoteLines       QuoteLine[]
  bookings         Booking[]
  shipments        Shipment[]
  shipmentCargoItems ShipmentCargoItem[]
  shipmentParties  ShipmentParty[]
  shipmentContainers ShipmentContainer[]
  trackingEvents   TrackingEvent[]
  documents        Document[]
  documentAccessTokens DocumentAccessToken[]
  customerInvoices CustomerInvoice[]
  supplierInvoices SupplierInvoice[]
  payments         Payment[]
  expenses         Expense[]
  creditNotes      CreditNote[]
  exchangeRates    ExchangeRate[]
  financialAuditLogs FinancialAuditLog[]
  notifications    Notification[]
  notificationPreferences NotificationPreference[]
  companySupportRequests CompanySupportRequest[]
  companySupportMessages CompanySupportMessage[]
  raankoSupportTickets RaankoSupportTicket[]
  raankoSupportMessages RaankoSupportMessage[]
  customDomains    TenantCustomDomain[]
  emailSenders     TenantEmailSender[]
  webhookEndpoints WebhookEndpoint[]
  usageMeters      UsageMeter[]
  impersonationSessions ImpersonationSession[]
  platformAuditLogs PlatformAuditLog[]
  consolidations   ShipmentConsolidation[]
  consolidationHouses ShipmentConsolidationHouse[]

  @@map("tenants")
}

model Branch {
  id          String    @id @db.Char(26)
  tenantId    String    @map("tenant_id") @db.Char(26)
  name        String
  code        String?
  isMain      Boolean   @default(false) @map("is_main")
  addressLine String?   @map("address_line")
  city        String?
  countryCode String?   @map("country_code") @db.Char(2)
  isActive    Boolean   @default(true) @map("is_active")
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant                Tenant                 @relation(fields: [tenantId], references: [id])
  defaultForMemberships Membership[]           @relation("MembershipDefaultBranch")
  membershipBranches    MembershipBranch[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("branches")
}

model Role {
  id          String   @id @db.Char(26)
  tenantId    String   @map("tenant_id") @db.Char(26)
  key         String
  name        String
  description String?
  isSystem    Boolean  @default(true) @map("is_system")
  isBranchScoped Boolean @default(false) @map("is_branch_scoped")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  rolePermissions RolePermission[]
  memberships     Membership[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id          String   @id @db.Char(26)
  tenantId    String?  @map("tenant_id") @db.Char(26)
  key         String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  tenant          Tenant?          @relation(fields: [tenantId], references: [id])
  rolePermissions RolePermission[]

  @@unique([tenantId, key])
  @@index([key])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @db.Char(26)
  roleId       String   @map("role_id") @db.Char(26)
  permissionId String   @map("permission_id") @db.Char(26)
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model Membership {
  id              String           @id @db.Char(26)
  tenantId        String           @map("tenant_id") @db.Char(26)
  userId          String           @map("user_id") @db.Char(26)
  roleId          String           @map("role_id") @db.Char(26)
  status          MembershipStatus @default(invited)
  defaultBranchId String?          @map("default_branch_id") @db.Char(26)
  invitedAt       DateTime?        @map("invited_at")
  acceptedAt      DateTime?        @map("accepted_at")
  lastActiveAt    DateTime?        @map("last_active_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  tenant         Tenant             @relation(fields: [tenantId], references: [id])
  user           User               @relation(fields: [userId], references: [id])
  role           Role               @relation(fields: [roleId], references: [id])
  defaultBranch  Branch?            @relation("MembershipDefaultBranch", fields: [defaultBranchId], references: [id])
  branchScopes   MembershipBranch[]
  sessions       Session[]
  refreshTokens  RefreshToken[]
  invitations    Invitation[]

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId])
  @@map("memberships")
}

model MembershipBranch {
  id           String   @id @db.Char(26)
  membershipId String   @map("membership_id") @db.Char(26)
  branchId     String   @map("branch_id") @db.Char(26)
  createdAt    DateTime @default(now()) @map("created_at")

  membership Membership @relation(fields: [membershipId], references: [id])
  branch     Branch     @relation(fields: [branchId], references: [id])

  @@unique([membershipId, branchId])
  @@map("membership_branches")
}

model Subscription {
  id              String             @id @db.Char(26)
  tenantId        String             @map("tenant_id") @db.Char(26)
  planId          String             @map("plan_id") @db.Char(26)
  status          SubscriptionStatus @default(trial)
  trialStartsAt   DateTime?          @map("trial_starts_at")
  trialEndsAt     DateTime?          @map("trial_ends_at")
  currentPeriodStart DateTime?       @map("current_period_start")
  currentPeriodEnd   DateTime?       @map("current_period_end")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([tenantId])
  @@map("subscriptions")
}

model TenantFeatureOverride {
  id        String   @id @db.Char(26)
  tenantId  String   @map("tenant_id") @db.Char(26)
  featureId String   @map("feature_id") @db.Char(26)
  enabled   Boolean
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  feature Feature @relation(fields: [featureId], references: [id])

  @@unique([tenantId, featureId])
  @@map("tenant_feature_overrides")
}

model Invitation {
  id           String           @id @db.Char(26)
  tenantId     String           @map("tenant_id") @db.Char(26)
  email        String
  kind         InvitationKind
  status       InvitationStatus @default(pending)
  roleId       String?          @map("role_id") @db.Char(26)
  membershipId String?          @map("membership_id") @db.Char(26)
  tokenHash    String           @unique @map("token_hash")
  invitedById  String?          @map("invited_by_id") @db.Char(26)
  expiresAt    DateTime         @map("expires_at")
  acceptedAt   DateTime?        @map("accepted_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  membership Membership? @relation(fields: [membershipId], references: [id])
  invitedBy  User?       @relation("InvitationInviter", fields: [invitedById], references: [id])

  @@index([tenantId, email])
  @@map("invitations")
}

model PortalAccount {
  id         String    @id @db.Char(26)
  tenantId   String    @map("tenant_id") @db.Char(26)
  userId     String    @map("user_id") @db.Char(26)
  // Customer link added in CRM slice; nullable placeholder for auth surface
  customerId String?   @map("customer_id") @db.Char(26)
  status     String    @default("active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  user          User           @relation(fields: [userId], references: [id])
  customer      Customer?      @relation(fields: [customerId], references: [id])
  sessions      Session[]
  refreshTokens RefreshToken[]
  quoteRequests QuoteRequest[]

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([customerId])
  @@map("portal_accounts")
}

// ─── CRM / suppliers / quotes / shipments (MVP slices 5–8) ───────────────────

enum CustomerActivityType {
  note
  task
  call
  meeting
}

enum ImportJobKind {
  customers
  rates
}

enum ImportJobStatus {
  queued
  completed
  failed
}

enum QuoteRequestStatus {
  received
  in_review
  quoted
  closed
}

enum QuoteStatus {
  draft
  sent
  accepted
  declined
}

enum BookingStatus {
  draft
  confirmed
  cancelled
}

enum ShipmentStatus {
  draft
  booked
  in_transit
  arrived
  delivered
  cancelled
}

enum ShipmentPartyRole {
  shipper
  consignee
  notify
}

model Customer {
  id               String    @id @db.Char(26)
  tenantId         String    @map("tenant_id") @db.Char(26)
  legalName        String    @map("legal_name")
  displayName      String    @map("display_name")
  email            String?
  phone            String?
  city             String?
  countryCode      String?   @map("country_code") @db.Char(2)
  notes            String?
  defaultCurrency  String    @default("EUR") @map("default_currency") @db.Char(3)
  deletedAt        DateTime? @map("deleted_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tenant           Tenant              @relation(fields: [tenantId], references: [id])
  activities       CustomerActivity[]
  portalAccounts   PortalAccount[]
  quoteRequests    QuoteRequest[]
  quotes           Quote[]
  bookings         Booking[]
  shipments        Shipment[]

  @@index([tenantId])
  @@index([tenantId, email])
  @@index([tenantId, phone])
  @@map("customers")
}

model CustomerActivity {
  id              String                @id @db.Char(26)
  tenantId        String                @map("tenant_id") @db.Char(26)
  customerId      String                @map("customer_id") @db.Char(26)
  type            CustomerActivityType
  title           String
  body            String?
  dueAt           DateTime?             @map("due_at")
  completedAt     DateTime?             @map("completed_at")
  createdByUserId String?               @map("created_by_user_id") @db.Char(26)
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([tenantId, customerId])
  @@map("customer_activities")
}

model ImportJob {
  id           String          @id @db.Char(26)
  tenantId     String          @map("tenant_id") @db.Char(26)
  kind         ImportJobKind
  status       ImportJobStatus @default(queued)
  totalRows    Int             @default(0) @map("total_rows")
  successCount Int             @default(0) @map("success_count")
  errorCount   Int             @default(0) @map("error_count")
  errors       Json            @default("[]")
  createdByUserId String?      @map("created_by_user_id") @db.Char(26)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("import_jobs")
}

model Supplier {
  id        String    @id @db.Char(26)
  tenantId  String    @map("tenant_id") @db.Char(26)
  name      String
  code      String?
  email     String?
  phone     String?
  notes     String?
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  rateSheets RateSheet[]

  @@index([tenantId])
  @@unique([tenantId, name])
  @@map("suppliers")
}

model RateSheet {
  id         String    @id @db.Char(26)
  tenantId   String    @map("tenant_id") @db.Char(26)
  supplierId String    @map("supplier_id") @db.Char(26)
  name       String
  currency   String    @default("EUR") @db.Char(3)
  validFrom  DateTime? @map("valid_from")
  validTo    DateTime? @map("valid_to")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  supplier Supplier   @relation(fields: [supplierId], references: [id])
  lines    RateLine[]

  @@index([tenantId, supplierId])
  @@map("rate_sheets")
}

model RateLine {
  id           String   @id @db.Char(26)
  tenantId     String   @map("tenant_id") @db.Char(26)
  rateSheetId  String   @map("rate_sheet_id") @db.Char(26)
  origin       String?
  destination  String?
  mode         String?
  containerType String? @map("container_type")
  unit         String   @default("shipment")
  buyRate      Decimal  @map("buy_rate") @db.Decimal(18, 4)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  rateSheet RateSheet @relation(fields: [rateSheetId], references: [id])

  @@index([tenantId, rateSheetId])
  @@map("rate_lines")
}

model ChargeTemplate {
  id                String   @id @db.Char(26)
  tenantId          String   @map("tenant_id") @db.Char(26)
  code              String
  name              String
  currency          String   @default("EUR") @db.Char(3)
  defaultSellAmount Decimal  @default(0) @map("default_sell_amount") @db.Decimal(18, 4)
  defaultBuyAmount  Decimal  @default(0) @map("default_buy_amount") @db.Decimal(18, 4)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("charge_templates")
}

model QuoteRequest {
  id              String             @id @db.Char(26)
  tenantId        String             @map("tenant_id") @db.Char(26)
  customerId      String?            @map("customer_id") @db.Char(26)
  portalAccountId String?            @map("portal_account_id") @db.Char(26)
  status          QuoteRequestStatus @default(received)
  origin          String?
  destination     String?
  mode            String?
  cargoDescription String?           @map("cargo_description")
  notes           String?
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  customer      Customer?      @relation(fields: [customerId], references: [id])
  portalAccount PortalAccount? @relation(fields: [portalAccountId], references: [id])
  quotes        Quote[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("quote_requests")
}

model Quote {
  id             String      @id @db.Char(26)
  tenantId       String      @map("tenant_id") @db.Char(26)
  quoteFamilyId  String      @map("quote_family_id") @db.Char(26)
  versionNumber  Int         @default(1) @map("version_number")
  quoteRequestId String?     @map("quote_request_id") @db.Char(26)
  customerId     String?     @map("customer_id") @db.Char(26)
  status         QuoteStatus @default(draft)
  currency       String      @default("EUR") @db.Char(3)
  notes          String?
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  quoteRequest QuoteRequest? @relation(fields: [quoteRequestId], references: [id])
  customer     Customer?     @relation(fields: [customerId], references: [id])
  lines        QuoteLine[]
  bookings     Booking[]
  shipments    Shipment[]

  @@unique([quoteFamilyId, versionNumber])
  @@index([tenantId])
  @@index([tenantId, quoteFamilyId])
  @@map("quotes")
}

model QuoteLine {
  id          String   @id @db.Char(26)
  tenantId    String   @map("tenant_id") @db.Char(26)
  quoteId     String   @map("quote_id") @db.Char(26)
  description String
  chargeCode  String?  @map("charge_code")
  buyAmount   Decimal  @default(0) @map("buy_amount") @db.Decimal(18, 4)
  sellAmount  Decimal  @default(0) @map("sell_amount") @db.Decimal(18, 4)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  quote  Quote  @relation(fields: [quoteId], references: [id])

  @@index([tenantId, quoteId])
  @@map("quote_lines")
}

model Booking {
  id         String        @id @db.Char(26)
  tenantId   String        @map("tenant_id") @db.Char(26)
  quoteId    String        @map("quote_id") @db.Char(26)
  shipmentId String?       @map("shipment_id") @db.Char(26)
  customerId String?       @map("customer_id") @db.Char(26)
  status     BookingStatus @default(confirmed)
  notes      String?
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  quote    Quote     @relation(fields: [quoteId], references: [id])
  shipment Shipment? @relation("BookingShipment", fields: [shipmentId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([tenantId])
  @@index([quoteId])
  @@map("bookings")
}

model Shipment {
  id              String         @id @db.Char(26)
  tenantId        String         @map("tenant_id") @db.Char(26)
  bookingId       String?        @map("booking_id") @db.Char(26)
  quoteId         String?        @map("quote_id") @db.Char(26)
  customerId      String?        @map("customer_id") @db.Char(26)
  trackingNumber  String         @map("tracking_number")
  status          ShipmentStatus @default(draft)
  origin          String?
  destination     String?
  mode            String?
  notes           String?
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  tenant     Tenant               @relation(fields: [tenantId], references: [id])
  quote      Quote?               @relation(fields: [quoteId], references: [id])
  customer   Customer?            @relation(fields: [customerId], references: [id])
  bookings   Booking[]            @relation("BookingShipment")
  cargoItems ShipmentCargoItem[]
  parties    ShipmentParty[]
  containers ShipmentContainer[]
  events     TrackingEvent[]
  masterConsolidations ShipmentConsolidation[] @relation("ConsolidationMaster")
  houseConsolidationLinks ShipmentConsolidationHouse[] @relation("ConsolidationHouse")

  @@unique([tenantId, trackingNumber])
  @@index([tenantId])
  @@index([trackingNumber])
  @@map("shipments")
}

model ShipmentCargoItem {
  id          String   @id @db.Char(26)
  tenantId    String   @map("tenant_id") @db.Char(26)
  shipmentId  String   @map("shipment_id") @db.Char(26)
  description String
  quantity    Decimal  @default(1) @db.Decimal(18, 4)
  weightKg    Decimal? @map("weight_kg") @db.Decimal(18, 4)
  volumeCbm   Decimal? @map("volume_cbm") @db.Decimal(18, 4)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  shipment Shipment @relation(fields: [shipmentId], references: [id])

  @@index([tenantId, shipmentId])
  @@map("shipment_cargo_items")
}

model ShipmentParty {
  id         String            @id @db.Char(26)
  tenantId   String            @map("tenant_id") @db.Char(26)
  shipmentId String            @map("shipment_id") @db.Char(26)
  role       ShipmentPartyRole
  name       String
  email      String?
  phone      String?
  address    String?
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  shipment Shipment @relation(fields: [shipmentId], references: [id])

  @@index([tenantId, shipmentId])
  @@map("shipment_parties")
}

model ShipmentContainer {
  id            String   @id @db.Char(26)
  tenantId      String   @map("tenant_id") @db.Char(26)
  shipmentId    String   @map("shipment_id") @db.Char(26)
  containerNo   String?  @map("container_no")
  containerType String?  @map("container_type")
  sealNo        String?  @map("seal_no")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  shipment Shipment @relation(fields: [shipmentId], references: [id])

  @@index([tenantId, shipmentId])
  @@map("shipment_containers")
}

model TrackingEvent {
  id         String   @id @db.Char(26)
  tenantId   String   @map("tenant_id") @db.Char(26)
  shipmentId String   @map("shipment_id") @db.Char(26)
  status     String
  message    String?
  isPublic   Boolean  @default(false) @map("is_public")
  occurredAt DateTime @default(now()) @map("occurred_at")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  shipment Shipment @relation(fields: [shipmentId], references: [id])

  @@index([tenantId, shipmentId])
  @@map("tracking_events")
}

// ─── Documents / finance / notifications / support (MVP slices 9–13) ─────────

enum DocumentVisibility {
  customer
  internal
}

enum CustomerInvoiceStatus {
  draft
  issued
  voided
}

enum SupplierInvoiceStatus {
  draft
  recorded
  paid
  voided
}

enum SupportStatus {
  open
  in_progress
  resolved
  closed
}

model Document {
  id         String              @id @db.Char(26)
  tenantId   String              @map("tenant_id") @db.Char(26)
  entityType String              @map("entity_type")
  entityId   String              @map("entity_id") @db.Char(26)
  visibility DocumentVisibility  @default(internal)
  storageKey String              @map("storage_key")
  filename   String
  mimeType   String              @map("mime_type")
  sizeBytes  Int                 @map("size_bytes")
  generated  Boolean             @default(false)
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  tenant        Tenant                 @relation(fields: [tenantId], references: [id])
  accessTokens  DocumentAccessToken[]
  versions      DocumentVersion[]

  @@index([tenantId])
  @@index([tenantId, entityType, entityId])
  @@map("documents")
}

model DocumentAccessToken {
  id         String   @id @db.Char(26)
  tenantId   String   @map("tenant_id") @db.Char(26)
  documentId String   @map("document_id") @db.Char(26)
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  document Document @relation(fields: [documentId], references: [id])

  @@index([documentId])
  @@map("document_access_tokens")
}

model CustomerInvoice {
  id           String                 @id @db.Char(26)
  tenantId     String                 @map("tenant_id") @db.Char(26)
  customerId   String                 @map("customer_id") @db.Char(26)
  shipmentId   String?                @map("shipment_id") @db.Char(26)
  quoteId      String?                @map("quote_id") @db.Char(26)
  number       String
  status       CustomerInvoiceStatus  @default(draft)
  currency     String                 @default("EUR") @db.Char(3)
  subtotal     Decimal                @default(0) @db.Decimal(18, 4)
  tax          Decimal                @default(0) @db.Decimal(18, 4)
  total        Decimal                @default(0) @db.Decimal(18, 4)
  paidAmount   Decimal                @default(0) @map("paid_amount") @db.Decimal(18, 4)
  outstanding  Decimal                @default(0) @db.Decimal(18, 4)
  issuedAt     DateTime?              @map("issued_at")
  voidedAt     DateTime?              @map("voided_at")
  notes        String?
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  payments   Payment[]
  creditNotes CreditNote[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([tenantId, customerId])
  @@map("customer_invoices")
}

model SupplierInvoice {
  id         String                @id @db.Char(26)
  tenantId   String                @map("tenant_id") @db.Char(26)
  supplierId String?               @map("supplier_id") @db.Char(26)
  shipmentId String?               @map("shipment_id") @db.Char(26)
  number     String
  status     SupplierInvoiceStatus @default(draft)
  currency   String                @default("EUR") @db.Char(3)
  amount     Decimal               @default(0) @db.Decimal(18, 4)
  notes      String?
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([tenantId, shipmentId])
  @@map("supplier_invoices")
}

model Payment {
  id                String   @id @db.Char(26)
  tenantId          String   @map("tenant_id") @db.Char(26)
  customerInvoiceId String?  @map("customer_invoice_id") @db.Char(26)
  amount            Decimal  @db.Decimal(18, 4)
  currency          String   @default("EUR") @db.Char(3)
  method            String   @default("bank")
  receivedAt        DateTime @default(now()) @map("received_at")
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  customerInvoice CustomerInvoice? @relation(fields: [customerInvoiceId], references: [id])

  @@index([tenantId])
  @@index([customerInvoiceId])
  @@map("payments")
}

model Expense {
  id         String   @id @db.Char(26)
  tenantId   String   @map("tenant_id") @db.Char(26)
  shipmentId String?  @map("shipment_id") @db.Char(26)
  category   String   @default("other")
  amount     Decimal  @db.Decimal(18, 4)
  currency   String   @default("EUR") @db.Char(3)
  notes      String?
  incurredAt DateTime @default(now()) @map("incurred_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, shipmentId])
  @@map("expenses")
}

model CreditNote {
  id                String   @id @db.Char(26)
  tenantId          String   @map("tenant_id") @db.Char(26)
  customerInvoiceId String   @map("customer_invoice_id") @db.Char(26)
  amount            Decimal  @db.Decimal(18, 4)
  currency          String   @default("EUR") @db.Char(3)
  reason            String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  customerInvoice CustomerInvoice @relation(fields: [customerInvoiceId], references: [id])

  @@index([tenantId])
  @@map("credit_notes")
}

model ExchangeRate {
  id             String   @id @db.Char(26)
  tenantId       String   @map("tenant_id") @db.Char(26)
  baseCurrency   String   @map("base_currency") @db.Char(3)
  quoteCurrency  String   @map("quote_currency") @db.Char(3)
  rate           Decimal  @db.Decimal(18, 6)
  effectiveOn    DateTime @map("effective_on") @db.Date
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, baseCurrency, quoteCurrency, effectiveOn], map: "exchange_rates_unique_pair_date")
  @@index([tenantId])
  @@map("exchange_rates")
}

model FinancialAuditLog {
  id         String   @id @db.Char(26)
  tenantId   String   @map("tenant_id") @db.Char(26)
  actorUserId String? @map("actor_user_id") @db.Char(26)
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Char(26)
  payload    Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@map("financial_audit_logs")
}

model Notification {
  id         String    @id @db.Char(26)
  tenantId   String    @map("tenant_id") @db.Char(26)
  userId     String    @map("user_id") @db.Char(26)
  title      String
  body       String?
  entityType String?   @map("entity_type")
  entityId   String?   @map("entity_id") @db.Char(26)
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, userId])
  @@map("notifications")
}

model NotificationPreference {
  id           String   @id @db.Char(26)
  tenantId     String   @map("tenant_id") @db.Char(26)
  userId       String   @map("user_id") @db.Char(26)
  emailEnabled Boolean  @default(true) @map("email_enabled")
  inAppEnabled Boolean  @default(true) @map("in_app_enabled")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, userId])
  @@map("notification_preferences")
}

model CompanySupportRequest {
  id         String        @id @db.Char(26)
  tenantId   String        @map("tenant_id") @db.Char(26)
  customerId String?       @map("customer_id") @db.Char(26)
  subject    String
  body       String
  status     SupportStatus @default(open)
  entityType String?       @map("entity_type")
  entityId   String?       @map("entity_id") @db.Char(26)
  createdByUserId String?  @map("created_by_user_id") @db.Char(26)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  tenant   Tenant                   @relation(fields: [tenantId], references: [id])
  messages CompanySupportMessage[]

  @@index([tenantId])
  @@index([tenantId, customerId])
  @@map("company_support_requests")
}

model CompanySupportMessage {
  id        String   @id @db.Char(26)
  tenantId  String   @map("tenant_id") @db.Char(26)
  requestId String   @map("request_id") @db.Char(26)
  authorUserId String? @map("author_user_id") @db.Char(26)
  isStaff   Boolean  @default(false) @map("is_staff")
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant                 @relation(fields: [tenantId], references: [id])
  request CompanySupportRequest  @relation(fields: [requestId], references: [id])

  @@index([tenantId, requestId])
  @@map("company_support_messages")
}

model RaankoSupportTicket {
  id         String        @id @db.Char(26)
  tenantId   String        @map("tenant_id") @db.Char(26)
  subject    String
  body       String
  status     SupportStatus @default(open)
  entityType String?       @map("entity_type")
  entityId   String?       @map("entity_id") @db.Char(26)
  createdByUserId String?  @map("created_by_user_id") @db.Char(26)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  tenant   Tenant                  @relation(fields: [tenantId], references: [id])
  messages RaankoSupportMessage[]

  @@index([tenantId])
  @@map("raanko_support_tickets")
}

model RaankoSupportMessage {
  id        String   @id @db.Char(26)
  tenantId  String   @map("tenant_id") @db.Char(26)
  ticketId  String   @map("ticket_id") @db.Char(26)
  authorUserId String? @map("author_user_id") @db.Char(26)
  isPlatform Boolean @default(false) @map("is_platform")
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant               @relation(fields: [tenantId], references: [id])
  ticket RaankoSupportTicket  @relation(fields: [ticketId], references: [id])

  @@index([tenantId, ticketId])
  @@map("raanko_support_messages")
}

// ─── Phase 2 product modules ─────────────────────────────────────────────────

enum CustomDomainStatus {
  pending
  verified
  failed
}

enum WebhookDeliveryStatus {
  pending
  delivered
  failed
}

model TenantCustomDomain {
  id         String             @id @db.Char(26)
  tenantId   String             @map("tenant_id") @db.Char(26)
  hostname   String
  status     CustomDomainStatus @default(pending)
  verifiedAt DateTime?          @map("verified_at")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([hostname])
  @@index([tenantId])
  @@map("tenant_custom_domains")
}

model TenantEmailSender {
  id        String   @id @db.Char(26)
  tenantId  String   @map("tenant_id") @db.Char(26)
  fromEmail String   @map("from_email")
  fromName  String   @map("from_name")
  verified  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId])
  @@map("tenant_email_senders")
}

model WebhookEndpoint {
  id         String   @id @db.Char(26)
  tenantId   String   @map("tenant_id") @db.Char(26)
  url        String
  secretHash String   @map("secret_hash")
  hmacSecret String   @map("hmac_secret")
  events     String[]
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant     Tenant             @relation(fields: [tenantId], references: [id])
  deliveries WebhookDelivery[]

  @@index([tenantId])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id         String                @id @db.Char(26)
  endpointId String                @map("endpoint_id") @db.Char(26)
  eventType  String                @map("event_type")
  payload    Json
  status     WebhookDeliveryStatus @default(pending)
  attempts   Int                   @default(0)
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id])

  @@index([endpointId])
  @@map("webhook_deliveries")
}

model UsageMeter {
  id          String   @id @db.Char(26)
  tenantId    String   @map("tenant_id") @db.Char(26)
  metric      String
  value       Decimal  @default(0) @db.Decimal(18, 4)
  periodStart DateTime @map("period_start")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, metric, periodStart])
  @@index([tenantId])
  @@map("usage_meters")
}

model ImpersonationSession {
  id             String    @id @db.Char(26)
  platformUserId String    @map("platform_user_id") @db.Char(26)
  tenantId       String    @map("tenant_id") @db.Char(26)
  startedAt      DateTime  @default(now()) @map("started_at")
  endedAt        DateTime? @map("ended_at")
  reason         String?
  createdAt      DateTime  @default(now()) @map("created_at")

  platformUser User   @relation(fields: [platformUserId], references: [id])
  tenant       Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([platformUserId])
  @@map("impersonation_sessions")
}

model PlatformAuditLog {
  id          String   @id @db.Char(26)
  actorUserId String?  @map("actor_user_id") @db.Char(26)
  tenantId    String?  @map("tenant_id") @db.Char(26)
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id") @db.Char(26)
  payload     Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  actor  User?   @relation(fields: [actorUserId], references: [id])
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@map("platform_audit_logs")
}

model ShipmentConsolidation {
  id               String   @id @db.Char(26)
  tenantId         String   @map("tenant_id") @db.Char(26)
  masterShipmentId String   @map("master_shipment_id") @db.Char(26)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant         Tenant                        @relation(fields: [tenantId], references: [id])
  masterShipment Shipment                      @relation("ConsolidationMaster", fields: [masterShipmentId], references: [id])
  houses         ShipmentConsolidationHouse[]

  @@index([tenantId])
  @@index([masterShipmentId])
  @@map("shipment_consolidations")
}

model ShipmentConsolidationHouse {
  id              String @id @db.Char(26)
  tenantId        String @map("tenant_id") @db.Char(26)
  consolidationId String @map("consolidation_id") @db.Char(26)
  houseShipmentId String @map("house_shipment_id") @db.Char(26)

  tenant        Tenant                 @relation(fields: [tenantId], references: [id])
  consolidation ShipmentConsolidation  @relation(fields: [consolidationId], references: [id])
  houseShipment Shipment               @relation("ConsolidationHouse", fields: [houseShipmentId], references: [id])

  @@unique([consolidationId, houseShipmentId])
  @@index([tenantId])
  @@map("shipment_consolidation_houses")
}

model DocumentVersion {
  id            String   @id @db.Char(26)
  documentId    String   @map("document_id") @db.Char(26)
  versionNumber Int      @map("version_number")
  storageKey    String   @map("storage_key")
  createdAt     DateTime @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id])

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@map("document_versions")
}
